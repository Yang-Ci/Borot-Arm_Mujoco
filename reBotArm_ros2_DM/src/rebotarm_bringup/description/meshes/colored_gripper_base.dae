        <instance_geometry url="#gripper_base-geometry">
          <bind_material>
            <technique_common>
              <instance_material symbol="gripper_grey-symbol" target="#gripper_grey" />
              <instance_material symbol="hardware_black-symbol" target="#hardware_black" />
              <instance_material symbol="seeed_yellow-symbol" target="#seeed_yellow" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene" />
  </scene>
</COLLADA>